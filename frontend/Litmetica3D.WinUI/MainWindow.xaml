<Window x:Class="Litmetica3D.WinUI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Litmetica3D.WinUI" Title="Litematica 3D">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <local:FilePathConverter x:Key="FilePathConverter"/>
   <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="24"/>
   </Style>
   <Style x:Key="NavStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="20,10"/>
    <Setter Property="CornerRadius" Value="8"/>
   </Style>
   <DataTemplate x:Key="FileTemplate">
    <Grid ColumnSpacing="14" Padding="0,8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <FontIcon Glyph="&#xE8A5;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Spacing="3" ToolTipService.ToolTip="{Binding}">
      <TextBlock Text="{Binding Converter={StaticResource FilePathConverter}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Converter={StaticResource FilePathConverter}, ConverterParameter=directory}"
        FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </Grid>
   </DataTemplate>
   <DataTemplate x:Key="CubeTemplate">
    <Viewbox Width="64" Height="64">
     <Canvas Width="64" Height="64">
      <Path Data="M32,4 L58,19 L32,34 L6,19 Z" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.9"/>
      <Path Data="M6,23 L29,36 L29,61 L6,48 Z" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.35"/>
      <Path Data="M35,36 L58,23 L58,48 L35,61 Z" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.65"/>
     </Canvas>
    </Viewbox>
   </DataTemplate>
  </Grid.Resources>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
   <Grid x:Name="Header" Padding="32,16" ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
     <Viewbox Width="28" Height="28"><ContentControl ContentTemplate="{StaticResource CubeTemplate}" Content="cube"/></Viewbox>
     <TextBlock Text="Litematica 3D" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel x:Name="NavigationTabs" Grid.Column="1" Orientation="Horizontal" Spacing="4">
     <ToggleButton x:Name="ConvertTab" Content="转换" Tag="0" Style="{StaticResource NavStyle}" Click="Navigate"/>
     <ToggleButton x:Name="ActivityTab" Content="活动" Tag="1" Style="{StaticResource NavStyle}" Click="Navigate"/>
     <ToggleButton x:Name="SettingsTab" Content="设置" Tag="2" Style="{StaticResource NavStyle}" Click="Navigate"/>
    </StackPanel>
   </Grid>
  </Border>
  <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="32,12,32,0"/>
  <Grid x:Name="PageHost" Grid.Row="2" Margin="32,24,32,20" MaxWidth="1180" HorizontalAlignment="Stretch"/>
  <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="32,16">
   <Grid ColumnSpacing="24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="7" VerticalAlignment="Center">
     <TextBlock x:Name="Status" Text="添加投影，开始创作" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=Status}"/>
     <StackPanel Orientation="Horizontal" Spacing="16">
      <TextBlock x:Name="Elapsed" Text="本地转换 · Minecraft 26.2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock x:Name="ProgressLabel" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
     </StackPanel>
     <ProgressBar x:Name="Progress" Maximum="100" Value="0" Visibility="Collapsed"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
     <Button x:Name="CancelButton" Content="取消" Visibility="Collapsed" IsEnabled="False" Click="Cancel" Height="42"/>
     <Button x:Name="StartButton" Content="开始转换" Style="{StaticResource AccentButtonStyle}" Click="Start" MinWidth="140" Height="42" IsEnabled="False"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border x:Name="NavigationIndicator" Width="24" Height="2" CornerRadius="1"
    HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0"
    Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False"
    AutomationProperties.AccessibilityView="Raw"/>
 </Grid>
</Window>
