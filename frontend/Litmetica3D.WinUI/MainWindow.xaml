<Window x:Class="Litmetica3D.WinUI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Litematica 3D · WinUI">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="24"/>
   </Style>
  </Grid.Resources>
  <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
    PaneDisplayMode="Left" OpenPaneLength="240" SelectionChanged="Navigate">
   <NavigationView.Resources>
    <!-- One continuous indicator is drawn above the navigation pane instead of
         stretching/fading separate indicators in each item's template. -->
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent"/>
   </NavigationView.Resources>
   <NavigationView.PaneHeader>
    <StackPanel Margin="18,28,0,24" Spacing="6">
     <FontIcon Glyph="&#xE7F4;" FontSize="30" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
     <TextBlock Text="Litematica 3D" FontSize="23" FontWeight="SemiBold"/>
     <TextBlock Text="从方块到现实" Opacity="0.6"/>
    </StackPanel>
   </NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem Content="预设与转换" Tag="0" Icon="Home"/>
    <NavigationViewItem Content="高级参数" Tag="1" Icon="Setting"/>
    <NavigationViewItem Content="日志与报告" Tag="2" Icon="Document"/>
    <NavigationViewItem Content="应用设置" Tag="3" Icon="Manage"/>
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter>
    <StackPanel Margin="24,12,12,24" Spacing="6">
     <TextBlock Text="MINECRAFT 26.2" FontWeight="SemiBold"/>
     <TextBlock Text="内置原版模型与贴图" Opacity="0.6" FontSize="12"/>
     <TextBlock Text="v0.5.1 · WinUI 3" Opacity="0.6" FontSize="12"/>
     <TextBlock Text="作者：b站@ZZHaccount" Opacity="0.6" FontSize="12"/>
    </StackPanel>
   </NavigationView.PaneFooter>
   <Grid Padding="28,20,28,24" RowSpacing="16">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="PageTitle" Text="预设与转换" FontSize="28" FontWeight="SemiBold"/>
    <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True"/>
    <Grid x:Name="PageHost" Grid.Row="2"/>
    <Border Grid.Row="3" Style="{StaticResource CardStyle}">
     <Grid RowSpacing="12" ColumnSpacing="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="5">
       <TextBlock x:Name="Status" Text="准备就绪 · 选择投影开始转换" TextWrapping="Wrap"/>
       <TextBlock x:Name="Elapsed" Text="总耗时 00:00:00" Opacity="0.6" FontSize="12"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
       <Button x:Name="CancelButton" Content="取消" IsEnabled="False" Click="Cancel"/>
       <Button x:Name="StartButton" Content="开始转换" Style="{StaticResource AccentButtonStyle}" Click="Start"/>
      </StackPanel>
      <ProgressBar x:Name="Progress" Grid.Row="1" Grid.ColumnSpan="2" Maximum="100" Value="0"/>
     </Grid>
    </Border>
   </Grid>
  </NavigationView>
  <Border x:Name="NavigationIndicator" Width="3" Height="16" CornerRadius="1.5"
    HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0"
    Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False"
    AutomationProperties.AccessibilityView="Raw"/>
 </Grid>
</Window>
